# --- Database (Railway Postgres with pgvector) ---
DATABASE_URL=postgresql://user:password@host:5432/railway

# --- Redis (Railway Redis, used for conversation memory + rate limiting) ---
REDIS_URL=redis://default:password@host:6379

# --- Groq (LLM inference, free tier) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192

# --- Portfolio ---
PORTFOLIO_URL=https://varunsani.vercel.app
FRONTEND_ORIGIN_PROD=https://varunsani.vercel.app

# --- Retrieval tuning ---
TOP_K=5
SIMILARITY_THRESHOLD=0.3
VECTOR_WEIGHT=0.7
BM25_WEIGHT=0.3
MMR_LAMBDA=0.7

# --- Generation ---
LLM_TEMPERATURE=0.15
LLM_MAX_TOKENS=300

# --- Memory ---
CONVERSATION_TURNS=10
